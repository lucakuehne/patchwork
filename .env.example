# Verbindung zur PostgreSQL-Datenbank
DATABASE_URL=postgres://patchwork:patchwork@localhost:5432/patchwork

# Schlüssel zum Verschlüsseln gespeicherter Passwörter (Postfächer, LDAP).
# Mindestens 32 Zeichen, zufällig. Nach dem ersten Start nicht mehr ändern.
APP_SECRET=bitte-durch-einen-langen-zufaelligen-wert-ersetzen

# Öffentliche Adresse von Patchwork (für Links in Mails)
PUBLIC_URL=http://localhost:8080

# Port des Webservers
PORT=8080

# Ablage für Anhänge und Logo
DATA_DIR=./data

# Mail-Abruf aktivieren (true/false)
MAIL_POLLING=true

# Zeitzone für Datumsangaben in Mails (Standard: Europe/Zurich)
# TIME_ZONE=Europe/Zurich
